/**
 * x402 Monetized API Gateway — Cloudflare Worker
 *
 * Do not put a wallet, Cloudflare account_id, or API token in this file.
 * They show up in Workers dashboard / workers.dev metadata.
 *
 * After pull:
 *   npx wrangler secret put PAY_TO
 * paste your Base address when prompted.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "x402-gateway",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "single-page-application"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "APP",
				"class_name": "App"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["App"]
		}
	],
	"vars": {
		"NETWORK": "base-sepolia",
		"FACILITATOR_URL": "https://x402.org/facilitator"
	}
}
