/**
 * x402 Monetized API Gateway — Cloudflare Worker
 *
 * Completes the incomplete wrangler.json:
 * - Worker name
 * - ASSETS binding (required by src/index.ts)
 * - Durable Object APP + sqlite migration
 * - x402 PAY_TO / network (replace burn address before live traffic)
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "x402-gateway",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "single-page-application"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "APP",
				"class_name": "App"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["App"]
		}
	],
	"vars": {
		"PAY_TO": "0x000000000000000000000000000000000000dEaD",
		"NETWORK": "base-sepolia",
		"FACILITATOR_URL": "https://x402.org/facilitator"
	}
}
